# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# git worktrees (agent-managed isolated workspaces)
.worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env
.env*.local

# keep example committed
!.env.example

# local agent tooling
.claude/

# Supabase SQL (migrations/seed/reset) — applied manually via SQL Editor, not versioned.
# 앵커(/) 필수 — 없으면 src/lib/supabase/ 같은 하위 디렉터리까지 잡아서, 거기 새로
# 만든 파일이 조용히 커밋에서 빠진다(앱 코드가 통째로 무시될 뻔했다).
/supabase/

# 투명 로미 영상 원본(ProRes, 대용량) — 배포엔 변환된 .webm만
public/*.mov

# 부스 enrichment 원본 자료 — 참가자 스크랩 데이터와 아티스트 이미지 1738장(110MB).
# 여기서 뽑은 결과만 src/lib/booth/*.json으로 커밋한다(재생성 절차는 커밋 8f9bae1 참조).
public/SIF_booth_enrich/

# 하우스 아카이브 브랜드 디렉터리 원본(CSV 3종 + 인스타 이미지 69장 4.1MB).
# 여기서 뽑은 결과만 src/lib/booth/enrichment-house-archive-2026.json으로 커밋한다
# (재생성: node scripts/gen-house-archive-enrichment.mjs).
public/house_archive_br/

# 작업용 스크래치 — 가공 전 원본 스크린샷 등. 결과물만 커밋한다.
tmp/

# 도면·명단·포스터 원본(코엑스 홀 평면도, 참여자 명단, dwg, 4~6MB PNG/JPG) — 좌표
# 추출·enrichment 입력용 작업 자료다. public/에 두면 그대로 배포되므로 커밋하지
# 않고, 여기서 뽑은 결과(floorplan-*.json, *-cover.webp)만 커밋한다.
public/Hall_*
public/fair-map.jpg
public/*.dwg
public/코엑스-*.png
public/하우스아카이브*.png
public/Coex_도면/

# superpowers brainstorm scratch
.superpowers/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env
.env*.local

# keep example committed
!.env.example

# local agent tooling
.claude/

# Supabase SQL (migrations/seed/reset) — applied manually via SQL Editor, not versioned.
# 앵커(/) 필수 — 없으면 src/lib/supabase/ 같은 하위 디렉터리까지 잡아서, 거기 새로
# 만든 파일이 조용히 커밋에서 빠진다(앱 코드가 통째로 무시될 뻔했다).
/supabase/

# 투명 로미 영상 원본(ProRes, 대용량) — 배포엔 변환된 .webm만
public/*.mov

# 부스 enrichment 원본 자료 — 참가자 스크랩 데이터와 아티스트 이미지 1738장(110MB).
# 여기서 뽑은 결과만 src/lib/booth/*.json으로 커밋한다(재생성 절차는 커밋 8f9bae1 참조).
public/SIF_booth_enrich/

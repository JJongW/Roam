# Roam — environment. All optional: with none set, the app runs on the
# in-memory MockRepository (fully functional demo, no external infra).

# --- Supabase (set both to switch from mock to Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# roam_user 쿠키 서명 비밀키. 미설정 시 로컬 mock 개발용 고정값으로 폴백한다 —
# 실배포에는 반드시 무작위 긴 문자열로 설정할 것(안 그러면 쿠키 위조로 계정
# 탈취가 가능하다). 생성 예: openssl rand -base64 32
SESSION_SECRET=

# --- Firebase Cloud Messaging (Phase 3 push; optional) ---
NEXT_PUBLIC_FCM_API_KEY=
NEXT_PUBLIC_FCM_PROJECT_ID=
NEXT_PUBLIC_FCM_SENDER_ID=
NEXT_PUBLIC_FCM_APP_ID=
NEXT_PUBLIC_FCM_VAPID_KEY=
FCM_SERVER_KEY=

# Google Gemini (AI 빠른 추천 등). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 운영자 콘솔(/admin) 게이트 — 아래 둘 중 ADMIN_EMAILS가 있으면 그게 우선(Google
# 로그인 + 이메일 화이트리스트). 둘 다 비우면 게이트 자체가 꺼진다(로컬 mock
# 개발 전용 — 실배포에서 반드시 하나는 설정할 것).
# 쉼표로 구분한 허용 이메일. 예: ADMIN_EMAILS=owner@example.com,ops@example.com
ADMIN_EMAILS=
# 폴백: 공유 코드 게이트(ADMIN_EMAILS 미설정 시에만 쓰인다).
ORGANIZER_CODE=

# 네이티브 로그인(iOS) — Apple/Google ID 토큰의 aud 검증용. 둘 다 없으면 두
# /api/auth/*/native 엔드포인트가 500을 반환한다(로컬 mock 개발에선 안 씀).
APPLE_BUNDLE_ID=
GOOGLE_IOS_CLIENT_ID=
